/* Clean Text Stream TCSS */

Screen {
    background: #0d0e15;
    padding: 0;
    margin: 0;
}

#app-container {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: #0d0e15;
}

#chat-view {
    height: 1fr;
    padding: 1 3;
    background: #0d0e15;
    scrollbar-size: 1 1;
}

/* User Message - Clean Text */
.user-msg {
    width: 100%;
    margin: 1 0 0 0;
    color: #89b4fa;
}

/* Bot Message - Clean Text */
.bot-msg {
    width: 100%;
    margin: 1 0;
    color: #cdd6f4;
}

.bot-label {
    color: #a6e3a1;
    text-style: bold;
}

/* Input Bar - Minimal Prompt Line */
#message-input {
    margin: 0 3 1 3;
    border: none;
    border-top: solid #313244;
    background: #0d0e15;
    color: #cdd6f4;
}

#message-input:focus {
    border-top: solid #89b4fa;
}
