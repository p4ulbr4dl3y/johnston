/* Clean Text Stream TCSS */

Screen {
    background: #0d0e15;
    padding: 0;
    margin: 0;
}

#app-container {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: #0d0e15;
}

#chat-view {
    height: 1fr;
    padding: 1 3 0 3;
    background: #0d0e15;
    scrollbar-size: 1 1;
}

/* User Message */
.user-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #89b4fa;
}

/* Bot Message Container */
.bot-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #cdd6f4;
}

/* ThinkingWidget Styling */
.thinking-widget {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    color: #a6adc8;
    background: #11111b;
    border-left: solid #585b70;
}

.thinking-active {
    color: #f9e2af;
    border-left: solid #f9e2af;
}

.thinking-header {
    height: auto;
    margin: 0;
    padding: 0;
}

.thinking-widget Markdown {
    margin-top: 1;
    color: #a6adc8;
}

/* Distinct Tool Call Widget Styling */
.tool-call {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    background: #181825;
    border-left: solid #89b4fa;
    color: #cdd6f4;
}

.tool-create {
    border-left: solid #a6e3a1;
    background: #14241d;
    color: #a6e3a1;
}

.tool-read {
    border-left: solid #89b4fa;
    background: #172038;
    color: #89b4fa;
}

.tool-edit {
    border-left: solid #f9e2af;
    background: #2b2519;
    color: #f9e2af;
}

.tool-bash {
    border-left: solid #cba6f7;
    background: #231b30;
    color: #cba6f7;
}

.tool-header {
    height: auto;
    margin: 0;
    padding: 0;
}

.tool-call Markdown {
    margin-top: 1;
    color: #cdd6f4;
}

.tool-diff-view {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    background: #11111b;
    color: #cdd6f4;
}

/* Strict Height Auto & Zero Margin for Markdown Elements */
Markdown {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownParagraph {
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownBlock {
    height: auto;
    margin: 0;
    padding: 0;
}

Markdown BulletList {
    height: auto;
    margin: 0;
    padding: 0;
}

Markdown OrderedList {
    height: auto;
    margin: 0;
    padding: 0;
}

/* Command Suggestions Popup */
#command-suggestions {
    display: none;
    width: 100%;
    height: auto;
    max-height: 8;
    margin: 0;
    padding: 0 1;
    border: round #313244;
    background: #181825;
}

#command-suggestions OptionList {
    background: #181825;
    color: #a6adc8;
}

#command-suggestions OptionList > .option-list--option-highlighted {
    background: #ff9e64;
    color: #11111b;
    text-style: bold;
}

/* Dynamic Auto-Expanding ChatInput - Zero Margins */
#message-input {
    width: 100%;
    min-height: 3;
    max-height: 10;
    margin: 0;
    padding: 0 1;
    border: round #313244;
    background: #181825;
    color: #cdd6f4;
}

#message-input:focus {
    border: round #585b70;
    background: #181825;
}

/* Notifications (Toast) Docked Top Right */
ToastRack {
    dock: top;
    align: right top;
}

/* Modal Dialog Styles (/help & /resume) */
ModalScreen {
    align: center middle;
    background: rgba(13, 14, 21, 0.7);
}

#modal-dialog {
    width: 64;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: round #89b4fa;
    background: #181825;
}

.modal-title {
    width: 100%;
    text-align: center;
    color: #89b4fa;
    text-style: bold;
    margin-bottom: 1;
}

.modal-body {
    width: 100%;
    color: #cdd6f4;
    margin-bottom: 1;
}

.modal-markdown {
    width: 100%;
    height: auto;
    color: #cdd6f4;
}

.modal-markdown MarkdownHeader {
    text-align: center;
    color: #89b4fa;
    margin-bottom: 1;
}

#modal-dialog OptionList {
    height: 10;
    max-height: 12;
    margin-top: 1;
    border: round #313244;
    background: #11111b;
}

.modal-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.modal-buttons Button {
    margin-left: 1;
}

/* Status Footer */
#status-footer {
    width: 100%;
    height: 1;
    padding: 0 3;
    background: #11111b;
    color: #a6adc8;
}
