/* Text Selection for all Screens, Input fields and TextAreas */
.screen--selection,
.text-area--selection,
.input--selection,
Screen > .screen--selection,
TextArea > .text-area--selection,
Input > .input--selection,
Input > .selection,
.modal-input > .input--selection,
#message-input > .text-area--selection {
    background: $subtle !important;
    color: $fg-primary !important;
    text-style: none !important;
}

/* Dynamic True Color Cursors for all Input fields and TextAreas */
.input--cursor,
.text-area--cursor,
Input > .input--cursor,
TextArea > .text-area--cursor,
.modal-input > .input--cursor,
#message-input > .text-area--cursor {
    background: $fg-primary !important;
    color: $fg-inverted !important;
    text-style: none !important;
}


Screen {
    background: $bg-app;
    color: $fg-primary;
    padding: 0;
    margin: 0;
    layers: default overlay;
}

* {
    scrollbar-size: 0 0 !important;
    scrollbar-size-vertical: 0 !important;
    scrollbar-size-horizontal: 0 !important;
}

ScrollBar, ScrollBarCorner, ScrollBar > *, ScrollBarCorner > * {
    display: none !important;
    visibility: hidden !important;
    width: 0 !important;
    height: 0 !important;
}

Screen, ModalScreen, VerticalScroll, HorizontalScroll, ScrollView, OptionList, TextArea, Markdown, MarkdownViewer, DataTable, Tree, ListView, DirectoryTree, ScrollBar, ScrollBarCorner {
    scrollbar-size: 0 0 !important;
    scrollbar-size-vertical: 0 !important;
    scrollbar-size-horizontal: 0 !important;
}

#app-container {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: $bg-app;
}

#plan-notch-container {
    layer: overlay;
    dock: top;
    width: 100%;
    height: auto;
    align: center top;
    visibility: hidden;
    padding: 0;
    margin: 0;
}

#plan-notch {
    visibility: visible;
    width: 68;
    max-width: 90%;
    height: auto;
    background: $bg-surface;
    color: $fg-primary;
    border: solid $border;
    padding: 0 1;
    margin: 1 0 0 0;
}

#chat-view {
    height: 1fr;
    min-height: 3;
    padding: 0 2 1 2;
    background: $bg-app;
    scrollbar-size: 0 0;
}

/* Loading Indicator Overlay - Zinc Monochrome */
LoadingIndicator {
    color: $fg-muted;
    background: $bg-app;
}

LoadingIndicator.-textual-loading-indicator {
    background: $bg-app;
}

WelcomeWidget {
    width: 100%;
    height: 100%;
    align: center middle;
    content-align: center middle;
}

#welcome-logo {
    text-align: center;
    color: $fg-muted;
    text-style: bold;
}

.user-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    border-top: solid $border;
}

.user-msg-first {
    margin-top: 0;
    border-top: none;
}

.user-msg-prefix {
    width: auto;
    height: auto;
    padding: 1 0 0 0;
    color: $primary;
}

.user-msg-bubble {
    width: 1fr;
    height: auto;
    padding: 1 0 0 0;
    background: $bg-app;
    color: $fg-primary;
    text-align: left;
}

.user-msg-text {
    width: 100%;
    height: auto;
    color: $fg-primary;
}

.user-msg-att {
    width: 100%;
    height: auto;
    color: $fg-muted;
}

#modal-dialog .user-msg-bubble {
    background: $bg-app;
}

/* Bot Message Container - Primary Text */
.bot-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $fg-primary;
}

.bot-msg-stream {
    width: 100%;
    height: auto;
    color: $fg-primary;
}

/* Event Divider Styling - Full width centered zinc divider */
.event-divider {
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
    color: $fg-muted;
}

/* ThinkingWidget Styling - Subtle Zinc */
.thinking-widget {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $fg-muted;
}

.thinking-header {
    height: auto;
    margin: 0;
    padding: 0;
    color: $fg-muted;
}

.thinking-header-expandable:hover {
    color: $fg-secondary;
}

.thinking-widget Markdown, .thinking-content {
    margin-top: 1;
    color: $fg-muted;
}

/* Tool Call Widget Styling - Monochrome Slate cards */
.tool-call {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $fg-secondary;
}

.tool-scroll-box {
    width: 100%;
    height: auto;
    scrollbar-size: 0 0 !important;
}

.tool-sequential {
    margin-top: 0;
}

.tool-create, .tool-read, .tool-edit, .tool-shell, .tool-invoke_subagent {
    color: $fg-secondary;
}

.tool-header {
    height: auto;
    margin: 0;
    padding: 0;
    color: $fg-secondary;
}

.tool-header-expandable:hover {
    color: $fg-primary;
}

.tool-content, .tool-content-md {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    background: $bg-app;
    color: $fg-secondary;
    border-left: solid $border;
    text-wrap: wrap;
}

.tool-call Markdown {
    margin-top: 1;
    color: $fg-secondary;
}

/* Strict Height Auto & Zero Margin for Markdown Elements */
Markdown, MarkdownBlock, MarkdownParagraph, MarkdownBulletList, MarkdownOrderedList, MarkdownItem, MarkdownTable, MarkdownTableContent, MarkdownTableCellContents, MarkdownTableContent > .cell {
    color: $fg-primary;
    link-color: $fg-primary;
    link-color-hover: $fg-primary;
    link-background-hover: $bg-surface;
    link-style: underline;
    link-style-hover: bold;
}

MarkdownTableContent > .header {
    color: $primary;
    text-style: bold;
}

Markdown {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownParagraph {
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownBlock {
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownBlockQuote MarkdownParagraph {
    margin: 0;
    padding: 0;
}

MarkdownBulletList MarkdownParagraph,
MarkdownOrderedList MarkdownParagraph {
    margin: 0;
    padding: 0;
}

MarkdownBlockQuote MarkdownBlockQuote {
    margin: 0 0 0 2;
    padding: 0 0 0 1;
    border-left: solid $border;
    background: transparent;
}

MarkdownHeader {
    margin: 1 0 1 0;
}

MarkdownBulletList,
MarkdownOrderedList {
    height: auto;
    margin: 0;
    padding: 0;
}

CustomMarkdownFence,
MarkdownFence {
    background: $bg-surface;
    margin: 1 0;
    padding: 0;
    border: none;
    height: auto;
    width: 100%;
    max-width: 100%;
    overflow: hidden hidden;
    scrollbar-size: 0 0;
}


CustomMarkdownFence .fence-header,
MarkdownFence .fence-header {
    height: 1;
    width: 100%;
    max-width: 100%;
    background: $bg-surface;
    padding: 0 0 0 1;
}

CustomMarkdownFence .fence-lang,
MarkdownFence .fence-lang {
    color: $fg-muted;
    text-style: none;
    height: 1;
    width: 1fr;
    text-overflow: ellipsis;
    overflow: hidden;
}

CustomMarkdownFence .fence-copy-btn,
MarkdownFence .fence-copy-btn {
    height: 1;
    min-height: 1;
    min-width: 6;
    border: none;
    background: transparent;
    color: $fg-muted;
    text-style: none;
    padding: 0 1;
    margin: 0;
}

CustomMarkdownFence .fence-copy-btn:hover,
MarkdownFence .fence-copy-btn:hover,
CustomMarkdownFence .fence-copy-btn:focus,
MarkdownFence .fence-copy-btn:focus {
    background: transparent;
    color: $fg-secondary;
    text-style: none;
}

CustomMarkdownFence .fence-scroll-box,
MarkdownFence .fence-scroll-box {
    width: 100%;
    height: auto;
    scrollbar-size: 0 0 !important;
}

CustomMarkdownFence #code-content,
MarkdownFence #code-content {
    width: 100%;
    height: auto;
    padding: 0 1;
    background: $bg-surface;
    text-wrap: wrap;
}

/* OptionList Base Styles */
OptionList {
    background: $bg-surface;
    color: $fg-muted;
    scrollbar-size: 0 0;
}

OptionList > .option-list--option-highlighted,
OptionList > .option-list--option-blur-highlighted {
    background: $bg-inverted;
    color: $fg-inverted;
    text-style: bold;
}

OptionList > .option-list--option-hover {
    background: transparent;
}

/* Command Suggestions Popup - Square Solid Dark Border */
#command-suggestions {
    display: none;
    layer: overlay;
    dock: bottom;
    margin-bottom: 5;
    width: 100%;
    height: auto;
    max-height: 8;
    padding: 0;
    border: solid $border;
    background: $bg-surface;
    text-wrap: nowrap;
    text-overflow: clip;
}

#command-suggestions OptionList,
CommandSuggestions {
    background: $bg-surface;
    color: $fg-secondary;
    border: none;
    padding: 0;
    scrollbar-size: 0 0;
    text-wrap: nowrap;
    text-overflow: clip;
}

#command-suggestions OptionList > .option-list--option,
#command-suggestions > .option-list--option,
CommandSuggestions > .option-list--option {
    background: transparent;
    color: $fg-secondary;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

#command-suggestions OptionList > .option-list--option-highlighted,
#command-suggestions OptionList > .option-list--option-blur-highlighted,
#command-suggestions > .option-list--option-highlighted,
#command-suggestions > .option-list--option-blur-highlighted,
CommandSuggestions > .option-list--option-highlighted,
CommandSuggestions > .option-list--option-blur-highlighted {
    background: $bg-surface;
    color: $fg-primary;
    text-style: bold;
}

#command-suggestions OptionList > .option-list--option-hover,
#command-suggestions > .option-list--option-hover,
CommandSuggestions > .option-list--option-hover {
    background: transparent;
}

/* Dynamic Auto-Expanding ChatInput - Flat Zinc-900 with symmetric padding */
#message-input {
    width: 100%;
    min-height: 2;
    max-height: 6;
    margin: 0;
    padding: 1 1 1 1;
    border: none;
    background: $bg-surface;
    color: $fg-primary;
}

#message-input:focus {
    border: none;
    background: $bg-surface;
}

#message-input > .text-area--cursor-line {
    background: transparent;
}

#message-input > .text-area--selection {
    background: $subtle;
    color: $fg-primary;
}

#message-input > .text-area--placeholder {
    color: $fg-muted;
    background: transparent;
}

TextArea > .text-area--matching-bracket,
#message-input > .text-area--matching-bracket {
    background: transparent;
    text-style: none;
}


/* Suppress hover tooltips globally */
Tooltip {
    display: none !important;
}

/* Notifications (Toast) Docked Top Right - Monochrome Slate */
ToastRack {
    dock: top;
    align: right top;
}

Toast {
    background: $bg-surface;
    color: $fg-primary;
    border-left: solid $fg-primary;
    border-top: none;
    border-right: none;
    border-bottom: none;
}

Toast.-information {
    background: $bg-surface;
    color: $fg-primary;
    border-left: solid $accent-info;
}

Toast.-warning {
    background: $bg-surface;
    color: $fg-primary;
    border-left: solid $accent-warning;
}

Toast.-error {
    background: $bg-surface;
    color: $fg-primary;
    border-left: solid $accent-error;
}

/* Modal Dialog Styles - Pure Dark Glassmorphism Effect */
ModalScreen {
    align: center middle;
    background: $bg-overlay;
    overflow: hidden;
    scrollbar-size: 0 0 !important;
}

#modal-dialog {
    width: 90%;
    max-width: 78;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: solid $border;
    background: $bg-surface;
    overflow: hidden;
}

#modal-dialog.modal-dialog-compact {
    width: 90%;
    max-width: 56;
}

#modal-dialog.modal-dialog-medium,
#modal-dialog.wizard-dialog {
    width: 90%;
    max-width: 86;
}

#modal-dialog.modal-dialog-wide {
    width: 90%;
    max-width: 104;
}

#subagent-container {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: $bg-app;
}

#subagent-chat-view {
    height: 1fr;
    padding: 1 2 1 2;
    background: $bg-app;
    scrollbar-size: 0 0;
}

#wizard-title {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#wizard-title MarkdownHeader {
    text-align: left;
    color: $fg-primary;
    margin: 0 0 1 0;
}

#wizard-title MarkdownParagraph {
    text-align: left;
    color: $fg-primary;
    margin: 0;
}

#modal-search-input {
    margin: 0 0 1 0;
}

.modal-markdown {
    width: 100%;
    height: auto;
    color: $fg-secondary;
    margin-bottom: 0;
    padding: 0 1;
}

#help-tabs {
    width: 100%;
    height: auto;
    margin-top: 0;
    margin-bottom: 1;
    padding: 0;
}

.help-tab {
    width: auto;
    height: 1;
    color: $fg-muted;
    padding: 0 1;
    margin-right: 2;
}

.help-tab.active {
    background: $bg-surface;
    color: $fg-primary;
    text-style: bold;
}

.help-tab:hover {
    background: $bg-surface;
    color: $fg-primary;
}

.help-tab.active:hover {
    background: $bg-surface;
    color: $fg-primary;
}

#help-scroll-box {
    width: 100%;
    height: auto;
    max-height: 20;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 0 0 !important;
}

#help-body {
    color: $fg-primary;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0 1;
}

#api-key-current {
    margin-bottom: 1;
}

.modal-markdown-centered {
    dock: top;
    margin-bottom: 0;
    padding: 0 1;
}

.modal-markdown-centered MarkdownHeader,
.modal-markdown-centered MarkdownH1,
.modal-markdown-centered MarkdownH2,
.modal-markdown-centered MarkdownH3,
.modal-markdown-centered MarkdownH4,
.modal-markdown-centered MarkdownH5,
.modal-markdown-centered MarkdownH6,
#modal-dialog .modal-markdown-centered MarkdownHeader,
#modal-dialog .modal-markdown-centered MarkdownH1,
#modal-dialog .modal-markdown-centered MarkdownH2,
#modal-dialog .modal-markdown-centered MarkdownH3,
#modal-dialog .modal-markdown-centered MarkdownH4,
#modal-dialog .modal-markdown-centered MarkdownH5,
#modal-dialog .modal-markdown-centered MarkdownH6,
#wizard-title MarkdownHeader,
#wizard-title MarkdownH1,
#wizard-title MarkdownH2,
#wizard-title MarkdownH3 {
    content-align: left top !important;
    text-align: left !important;
    color: $fg-primary;
    margin: 0 0 1 0;
}

.modal-markdown-centered MarkdownParagraph,
#modal-dialog .modal-markdown-centered MarkdownParagraph {
    content-align: left top !important;
    text-align: left !important;
    color: $fg-secondary;
    margin: 0 0 1 0;
}

.modal-markdown-centered MarkdownBulletList,
#modal-dialog .modal-markdown-centered MarkdownBulletList {
    color: $fg-muted;
    margin-bottom: 1;
}

.modal-markdown-centered MarkdownBulletList MarkdownParagraph,
#modal-dialog .modal-markdown-centered MarkdownBulletList MarkdownParagraph {
    color: $fg-muted;
}

.modal-markdown.confirm-summary MarkdownParagraph {
    margin: 0;
}

.modal-markdown.confirm-summary MarkdownBulletList {
    margin-bottom: 1;
}

.modal-markdown.confirm-summary MarkdownBulletList:last-of-type {
    margin-bottom: 0;
}

#wizard-title.confirm-summary {
    margin-bottom: 0;
}

#wizard-summary-scroll {
    display: none;
    width: 100%;
    height: auto;
    margin-bottom: 0;
}

#wizard-summary {
    color: $fg-primary;
}

#rewind-files {
    display: none;
    width: 100%;
    height: auto;
    margin-bottom: 1;
    color: $fg-primary;
}

#modal-dialog.wizard-dialog .tool-scroll-box {
    margin: 1 0 0 0;
    max-height: 18;
    overflow-y: auto;
    overflow-x: auto;
    background: transparent;
    border: none;
    padding: 0;
    scrollbar-size: 0 0 !important;
}

#modal-dialog.wizard-dialog #wizard-summary-scroll {
    margin: 0;
}

DiffScreen {
    background: $bg-surface;
}

#diff-container {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: $bg-surface;
}

#diff-header {
    width: 100%;
    height: 3;
    padding: 1 2 0 2;
    background: $bg-surface;
    border-bottom: solid $border;
    color: $fg-muted;
}

#diff-body {
    width: 100%;
    height: 1fr;
    layout: horizontal;
    background: $bg-surface;
}

#diff-sidebar {
    width: 32;
    max-width: 40%;
    min-width: 22;
    height: 100%;
    background: $bg-surface;
    border-right: solid $border;
    padding: 0;
}

#diff-sidebar.-hidden {
    display: none;
}

#diff-content-container.-hidden {
    display: none;
}

#diff-sidebar.-full-width {
    width: 100%;
    max-width: 100%;
    min-width: 100%;
    border-right: none;
}

#diff-content-container.-full-width {
    width: 100%;
    max-width: 100%;
    min-width: 100%;
    padding: 0 1;
}

#diff-search-input,
#diff-search-input:focus {
    width: 100%;
    height: 1;
    margin: 1 0 1 0;
    padding: 0 1;
    border: none;
    background: transparent !important;
    color: $fg-primary;
}

#diff-search-input > .input--placeholder {
    color: $fg-muted;
}

#diff-file-list,
#diff-file-list:focus,
#diff-file-list:hover {
    height: 1fr;
    background: transparent !important;
    border: none !important;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    overflow-x: hidden;
    text-wrap: nowrap;
    text-overflow: clip;
    scrollbar-size: 0 0;
}

#diff-file-list > .option-list--option {
    background: transparent;
    padding: 0;
    text-wrap: nowrap;
}

#diff-file-list > .option-list--option-hover {
    background: $bg-surface;
    color: $fg-secondary;
}

#diff-file-list > .option-list--option-highlighted,
#diff-file-list > .option-list--option-blur-highlighted {
    background: $bg-surface;
    color: $fg-primary;
    text-style: bold;
}

#diff-content-container {
    width: 1fr;
    height: 100%;
    padding: 0 2 0 2;
    background: $bg-surface;
}

#diff-scroll-box,
#diff-scroll-box:focus {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overflow-x: auto;
    background: transparent;
    border: none;
    padding: 0 1;
    scrollbar-size: 0 0 !important;
}

#diff-content-view {
    width: 100%;
    height: auto;
    background: transparent;
    color: $fg-secondary;
    padding: 0;
    margin: 0;
}

#diff-empty-container {
    width: 100%;
    height: 1fr;
    align: center middle;
}

#diff-empty-label {
    color: $fg-muted;
}

#diff-footer {
    width: 100%;
    height: 3;
    padding: 0 2 1 2;
    background: $bg-surface;
    border-top: solid $border;
    color: $fg-muted;
}

#modal-dialog.bash-confirm-dialog,
#modal-dialog.task-console-dialog {
    width: 90%;
    max-width: 104;
    height: auto;
    max-height: 95%;
    overflow: hidden;
}

#modal-dialog.bash-confirm-dialog .modal-markdown {
    margin-bottom: 0;
}

#modal-dialog.bash-confirm-dialog CustomMarkdownFence,
#modal-dialog.bash-confirm-dialog MarkdownFence,
#modal-dialog.task-console-dialog CustomMarkdownFence,
#modal-dialog.task-console-dialog MarkdownFence {
    background: transparent;
    border: none;
    color: $fg-secondary;
    padding: 0;
    margin: 0;
}

#modal-dialog.bash-confirm-dialog CustomMarkdownFence .fence-header,
#modal-dialog.bash-confirm-dialog MarkdownFence .fence-header,
#modal-dialog.task-console-dialog CustomMarkdownFence .fence-header,
#modal-dialog.task-console-dialog MarkdownFence .fence-header {
    display: none;
}

#modal-dialog.bash-confirm-dialog CustomMarkdownFence #code-content,
#modal-dialog.bash-confirm-dialog MarkdownFence #code-content,
#modal-dialog.task-console-dialog CustomMarkdownFence #code-content,
#modal-dialog.task-console-dialog MarkdownFence #code-content {
    background: transparent;
    color: $fg-secondary;
    padding: 0;
    margin: 0;
}

#modal-dialog.bash-confirm-dialog #permission-options-list {
    margin-top: 1;
}

#modal-dialog.bash-confirm-dialog .tool-scroll-box,
#modal-dialog.task-console-dialog .tool-scroll-box {
    margin: 1 0 0 0;
    max-height: 18;
    overflow-y: auto;
    overflow-x: auto;
    background: transparent;
    border-left: solid $border;
    padding: 0 1;
    scrollbar-size: 0 0 !important;
}

#modal-dialog.task-console-dialog .tool-scroll-box {
    margin: 0 0 1 0;
    max-height: 8;
}

#modal-dialog.bash-confirm-dialog .modal-diff-view,
#modal-dialog.task-console-dialog .modal-diff-view {
    width: 100%;
    height: auto;
    background: transparent;
    color: $fg-secondary;
    padding: 0;
    margin: 0;
    text-wrap: wrap;
}

#modal-dialog #console-log,
ModalScreen #console-log {
    height: auto;
    max-height: 18;
    margin: 0;
    border-left: solid $border;
    padding: 0 1;
    background: transparent;
    color: $fg-secondary;
    scrollbar-size: 0 0 !important;
}

#modal-dialog OptionList,
#modal-dialog OptionList:focus,
#modal-dialog OptionList:hover,
#modal-dialog HeaderWrapOptionList,
#modal-dialog HeaderWrapOptionList:focus,
#modal-dialog HeaderWrapOptionList:hover,
ModalScreen OptionList,
ModalScreen OptionList:focus,
ModalScreen OptionList:hover {
    height: auto;
    max-height: 12;
    margin: 0;
    border: none;
    background: transparent !important;
    scrollbar-size: 0 0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#modal-dialog OptionList > .option-list--option,
ModalScreen OptionList > .option-list--option {
    background: transparent;
    color: $fg-secondary;
    padding: 0;
    text-wrap: nowrap;
}

#modal-dialog.wizard-dialog OptionList,
#modal-dialog.wizard-dialog HeaderWrapOptionList,
#options-list {
    text-wrap: nowrap;
    text-overflow: clip;
}

#modal-dialog.wizard-dialog OptionList > .option-list--option,
#modal-dialog.wizard-dialog HeaderWrapOptionList > .option-list--option,
#options-list > .option-list--option {
    padding: 0;
    text-wrap: nowrap;
}

#modal-dialog OptionList > .option-list--option-disabled,
ModalScreen OptionList > .option-list--option-disabled {
    color: $fg-muted;
    text-style: bold;
    opacity: 100%;
}

#modal-dialog OptionList > .option-list--option-highlighted,
#modal-dialog OptionList > .option-list--option-blur-highlighted,
ModalScreen OptionList > .option-list--option-highlighted,
ModalScreen OptionList > .option-list--option-blur-highlighted {
    background: transparent;
    color: $fg-primary;
    text-style: bold;
}

#modal-dialog OptionList > .option-list--option-hover,
ModalScreen OptionList > .option-list--option-hover {
    background: transparent;
}

#modal-dialog Input,
#modal-dialog Input:focus,
.modal-input,
.modal-input:focus {
    width: 100%;
    height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    border: none;
    background: transparent !important;
    color: $fg-primary;
}

#modal-dialog #write-in-input,
#modal-dialog #write-in-input:focus,
#write-in-input,
#write-in-input:focus {
    margin: 0;
    padding: 0 1;
}

#modal-dialog.wizard-dialog #write-in-input.subordinate,
#modal-dialog.wizard-dialog #write-in-input.subordinate:focus {
    margin: 1 0 0 0;
    padding: 0 0 0 5;
}

#modal-dialog.wizard-dialog #write-in-input.standalone,
#modal-dialog.wizard-dialog #write-in-input.standalone:focus {
    margin: 1 0 0 0;
    padding: 0 1;
}

#modal-dialog #reject-reason-input,
#modal-dialog #reject-reason-input:focus,
#reject-reason-input,
#reject-reason-input:focus {
    margin: 1 0 0 0;
    padding: 0 1;
}

#modal-dialog #shell-stdin-input,
#modal-dialog #shell-stdin-input:focus,
#shell-stdin-input,
#shell-stdin-input:focus {
    margin: 1 0 0 0;
    border: none;
    padding: 0 1;
}

#modal-dialog Input > .input--placeholder,
.modal-input > .input--placeholder {
    color: $fg-muted;
    background: transparent;
}

#modal-dialog Input > .input--selection,
.modal-input > .input--selection {
    background: $subtle;
    color: $fg-primary;
}

ModalHint,
#modal-hint {
    width: 100%;
    height: auto;
    text-align: left;
    color: $fg-muted;
    margin-top: 1;
    margin-bottom: 0;
    padding: 0;
    text-wrap: wrap;
}

#attachment-bar {
    width: 100%;
    height: 2;
    display: none;
    padding: 1 1 0 1;
    background: $bg-surface;
    color: $fg-muted;
    overflow-x: auto;
    overflow-y: hidden;
}

AttachmentChip {
    width: auto;
    height: 1;
    margin-right: 1;
    color: $fg-muted;
}

AttachmentHint {
    width: auto;
    height: 1;
    color: $fg-muted;
}


/* Status Footer - Matching dark grey background with muted zinc text */
#status-footer {
    width: 100%;
    height: 3;
    padding: 0 1 1 1;
    background: $bg-surface;
    color: $fg-muted;
}

#subagent-status-footer {
    width: 100%;
    height: 4;
    padding: 1 1 1 1;
    background: $bg-surface;
    color: $fg-muted;
}

/* Unified Markdown Headers Styling (Clean bold white, no underlines, left aligned) */
MarkdownH1, MarkdownH2, MarkdownH3, MarkdownH4, MarkdownH5, MarkdownH6,
MarkdownHeader {
    content-align: left top;
    text-align: left;
    text-style: bold;
    color: $fg-primary;
    background: transparent;
    border: none;
    margin: 1 0 1 0;
    padding: 0;
}

/* Markdown Table Styling - Clean Monochrome Slate header and borders */
MarkdownTableContent {
    keyline: thin $border;
}

MarkdownTableContent > .header {
    color: $fg-primary;
    text-style: bold;
    background: transparent;
}

MarkdownTableContent > .markdown-table--header {
    color: $fg-primary;
    text-style: bold;
}

MarkdownTableContent > .cell {
    color: $fg-primary;
}

/* Markdown List Bullets & Numbers - Muted Zinc */
MarkdownBullet {
    color: $fg-muted;
    text-style: bold;
}

/* Markdown Horizontal Rule (---) - Subtle Divider */
MarkdownHorizontalRule {
    border-bottom: solid $border;
    height: 1;
    padding-top: 1;
    margin-bottom: 1;
}

/* Markdown Blockquote - Clean Monochrome Slate (Dark Card without extra vertical lines) */
MarkdownBlockQuote {
    border-left: none;
    background: $bg-surface;
    color: $fg-secondary;
    margin: 1 0;
    padding: 0 1;
}

MarkdownBlockQuote MarkdownFence {
    border: none;
    margin: 0;
    background: transparent;
}

/* Markdown Inline Code - Clean Monochrome Slate (White text on dark zinc background) */
MarkdownBlock:dark > .code_inline,
MarkdownBlock:light > .code_inline,
MarkdownBlock > .code_inline {
    background: $bg-surface;
    color: $fg-primary;
}
