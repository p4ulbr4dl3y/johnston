/* Dynamic True Color Inversion Selection (Original text color becomes selection bg) */
.screen--selection,
.text-area--selection,
Screen > .screen--selection,
TextArea > .text-area--selection {
    text-style: reverse;
}

Screen {
    background: #09090b;
    padding: 0;
    margin: 0;
    scrollbar-size: 1 1;
    scrollbar-color: #a1a1aa #27272a;
    scrollbar-color-hover: #ffffff #3f3f46;
    scrollbar-color-active: #ffffff #52525b;
}

* {
    scrollbar-size: 1 1;
    scrollbar-color: #a1a1aa #27272a;
    scrollbar-color-hover: #ffffff #3f3f46;
    scrollbar-color-active: #ffffff #52525b;
}

#app-container {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: #09090b;
}

#chat-view {
    height: 1fr;
    padding: 1 2 1 2;
    background: #09090b;
    scrollbar-size: 1 1;
    scrollbar-color: #a1a1aa #27272a;
    scrollbar-color-hover: #ffffff #27272a;
    scrollbar-color-active: #ffffff #52525b;
}

WelcomeWidget {
    width: 100%;
    height: 100%;
    align: center middle;
    content-align: center middle;
}

#welcome-logo {
    text-align: center;
    color: #27272a;
    text-style: bold;
}

/* User Message - Pure White Accent */
.user-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #ffffff;
    text-style: bold;
}

/* Bot Message Container - Off-white Text */
.bot-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #f4f4f5;
}

/* ThinkingWidget Styling - Subtle Zinc */
.thinking-widget {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #71717a;
}

.thinking-active {
    color: #ffffff;
    text-style: bold;
}

.thinking-header {
    height: auto;
    margin: 0;
    padding: 0;
}

.thinking-widget Markdown {
    margin-top: 1;
    color: #a1a1aa;
}

/* Tool Call Widget Styling - Monochrome Slate cards */
.tool-call {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #d4d4d8;
}

.tool-sequential {
    margin-top: 0;
}

.tool-create, .tool-read, .tool-edit, .tool-bash {
    color: #d4d4d8;
}

.tool-header {
    height: auto;
    margin: 0;
    padding: 0;
}

.tool-call Markdown {
    margin-top: 1;
    color: #e4e4e7;
}

.tool-diff-view {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    background: #09090b;
    color: #e4e4e7;
}

/* Strict Height Auto & Zero Margin for Markdown Elements */
Markdown {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownParagraph {
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownBlock {
    height: auto;
    margin: 0;
    padding: 0;
}

Markdown BulletList {
    height: auto;
    margin: 0;
    padding: 0;
}

Markdown OrderedList {
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownFence {
    background: #18181b;
    margin: 1 0;
    padding: 0 2;
    border-left: solid #3f3f46;
    scrollbar-size: 0 0;
}

/* OptionList Base Styles */
OptionList {
    background: #18181b;
    color: #a1a1aa;
    scrollbar-size: 1 1;
    scrollbar-color: #a1a1aa #27272a;
    scrollbar-color-hover: #ffffff #27272a;
    scrollbar-color-active: #ffffff #3f3f46;
}

OptionList > .option-list--option-highlighted,
OptionList > .option-list--option-blur-highlighted {
    background: #ffffff;
    color: #09090b;
    text-style: bold;
}

/* Command Suggestions Popup - Square Solid Dark Border */
#command-suggestions {
    display: none;
    width: 100%;
    height: auto;
    max-height: 5;
    margin: 0;
    padding: 0;
    border-top: solid #27272a;
    border-left: solid #27272a;
    border-right: solid #27272a;
    border-bottom: none;
    background: #18181b;
}

#command-suggestions OptionList {
    background: #18181b;
    color: #a1a1aa;
    border: none;
    padding: 0;
    scrollbar-size: 0 0;
}

#command-suggestions OptionList > .option-list--option-highlighted,
#command-suggestions OptionList > .option-list--option-blur-highlighted {
    background: #ffffff;
    color: #09090b;
    text-style: bold;
}

/* Dynamic Auto-Expanding ChatInput - Flat Zinc-900 with bottom padding */
#message-input {
    width: 100%;
    min-height: 2;
    max-height: 6;
    margin: 0;
    padding: 0 1 1 1;
    border: none;
    background: #18181b;
    color: #f4f4f5;
}

#message-input:focus {
    border: none;
    background: #18181b;
}

#message-input > .text-area--cursor-line {
    background: transparent;
}

#message-input > .text-area--selection {
    background: #ffffff;
    color: #09090b;
}

/* Notifications (Toast) Docked Top Right - Monochrome Slate */
ToastRack {
    dock: top;
    align: right top;
}

Toast {
    background: #18181b;
    color: #f4f4f5;
    border-left: solid #ffffff;
    border-top: none;
    border-right: none;
    border-bottom: none;
}

Toast.-information {
    background: #18181b;
    color: #f4f4f5;
    border-left: solid #ffffff;
}

Toast.-warning {
    background: #18181b;
    color: #f4f4f5;
    border-left: solid #a1a1aa;
}

Toast.-error {
    background: #18181b;
    color: #ffffff;
    border-left: solid #ffffff;
}

/* Modal Dialog Styles - Pure Dark Glassmorphism Effect */
ModalScreen {
    align: center middle;
    background: rgba(9, 9, 11, 0.85);
}

#modal-dialog {
    width: 90%;
    max-width: 64;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: solid #27272a;
    background: #18181b;
}

.modal-title {
    width: 100%;
    text-align: center;
    color: #ffffff;
    text-style: bold;
    margin-bottom: 1;
}

.modal-body {
    width: 100%;
    color: #e4e4e7;
    margin-bottom: 1;
}

.modal-markdown {
    width: 100%;
    height: auto;
    color: #e4e4e7;
}

.modal-markdown MarkdownHeader {
    text-align: center;
    color: #ffffff;
    margin-bottom: 1;
}

#modal-dialog OptionList {
    height: auto;
    max-height: 10;
    margin-top: 1;
    border: none;
    background: #18181b;
    scrollbar-size: 1 1;
    scrollbar-color: #3f3f46 #18181b;
    scrollbar-color-hover: #ffffff #27272a;
    scrollbar-color-active: #ffffff #3f3f46;
}

#modal-dialog OptionList > .option-list--option-highlighted,
#modal-dialog OptionList > .option-list--option-blur-highlighted {
    background: #ffffff;
    color: #09090b;
    text-style: bold;
}

#modal-dialog Input,
#write-in-input,
#modal-search-input,
#api-key-input {
    margin-top: 1;
    background: #09090b;
    border: solid #27272a;
    color: #f4f4f5;
}

#modal-dialog Input:focus,
#write-in-input:focus,
#modal-search-input:focus,
#api-key-input:focus {
    border: solid #52525b;
}

.modal-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.modal-buttons Button {
    margin-left: 1;
}

/* Status Footer - Matching dark grey background with muted zinc text */
#status-footer {
    width: 100%;
    height: 3;
    padding: 0 1;
    background: #18181b;
    color: #71717a;
}
