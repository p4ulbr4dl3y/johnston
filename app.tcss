/* Ultra-Minimalist Modern TCSS */

Screen {
    background: #0d0e15;
    padding: 0;
    margin: 0;
}

#app-container {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: #0d0e15;
}

#chat-view {
    height: 1fr;
    padding: 1 3;
    background: #0d0e15;
    scrollbar-size: 1 1;
}

/* User Message Bubble */
.user-bubble {
    align-horizontal: right;
    max-width: 80%;
    margin: 1 0;
    padding: 1 2;
    background: #2563eb 15%;
    border: round #3b82f6;
    color: #f8fafc;
}

/* Bot Message Bubble */
.bot-bubble {
    align-horizontal: left;
    max-width: 85%;
    margin: 1 0;
    padding: 1 2;
    background: #181825;
    border: round #313244;
}

.bot-author {
    color: #89b4fa;
    text-style: bold;
    margin-bottom: 1;
}

/* Bottom Input Bar */
#message-input {
    margin: 1 3 1 3;
    padding: 0 1;
    border: round #45475a;
    background: #1e1e2e;
    color: #cdd6f4;
}

#message-input:focus {
    border: round #89b4fa;
}
