/* Dynamic True Color Inversion Selection for all Screens, Input fields and TextAreas */
.screen--selection,
.text-area--selection,
.input--selection,
Screen > .screen--selection,
TextArea > .text-area--selection,
Input > .input--selection,
Input > .selection,
#message-input > .text-area--selection,
#write-in-input > .input--selection,
#modal-search-input > .input--selection,
#api-key-input > .input--selection {
    background: #ffffff !important;
    color: #09090b !important;
    text-style: none !important;
}

Screen {
    background: #09090b;
    padding: 0;
    margin: 0;
    layers: default overlay;
}

* {
    scrollbar-size: 0 0 !important;
    scrollbar-size-vertical: 0 !important;
    scrollbar-size-horizontal: 0 !important;
}

ScrollBar, ScrollBarCorner, ScrollBar > *, ScrollBarCorner > * {
    display: none !important;
    visibility: hidden !important;
    width: 0 !important;
    height: 0 !important;
}

Screen, ModalScreen, VerticalScroll, HorizontalScroll, ScrollView, OptionList, TextArea, Markdown, MarkdownViewer, DataTable, Tree, ListView, DirectoryTree, ScrollBar, ScrollBarCorner {
    scrollbar-size: 0 0 !important;
    scrollbar-size-vertical: 0 !important;
    scrollbar-size-horizontal: 0 !important;
}

#app-container {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: #09090b;
}

#chat-view {
    height: 1fr;
    padding: 1 2 1 2;
    background: #09090b;
    scrollbar-size: 0 0;
}

WelcomeWidget {
    width: 100%;
    height: 100%;
    align: center middle;
    content-align: center middle;
}

#welcome-logo {
    text-align: center;
    color: #52525b;
    text-style: bold;
}

.user-msg {
    width: 100%;
    height: auto;
    align: right top;
    margin-top: 1;
}

.user-msg-bubble {
    width: auto;
    max-width: 85%;
    height: auto;
    padding: 1 2;
    background: #18181b;
    color: #ffffff;
    text-align: left;
}

.user-msg-text {
    width: auto;
    height: auto;
    color: #ffffff;
}

.user-msg-att {
    width: auto;
    height: auto;
    color: #71717a;
}

#modal-dialog .user-msg-bubble {
    background: #27272a;
}

/* Bot Message Container - Off-white Text */
.bot-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #f4f4f5;
}

.bot-msg-stream {
    width: 100%;
    height: auto;
    color: #f4f4f5;
}

/* Event Divider Styling - Full width centered zinc divider */
.event-divider {
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
    color: #71717a;
}

/* ThinkingWidget Styling - Subtle Zinc */
.thinking-widget {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #71717a;
}

.thinking-header {
    height: auto;
    margin: 0;
    padding: 0;
    color: #71717a;
}

.thinking-header-expandable:hover {
    color: #ffffff;
}

.thinking-widget Markdown, .thinking-content {
    margin-top: 1;
    color: #a1a1aa;
}

/* Tool Call Widget Styling - Monochrome Slate cards */
.tool-call {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #d4d4d8;
}

.tool-scroll-box {
    width: 100%;
    height: auto;
    scrollbar-size: 0 0 !important;
}

.tool-sequential {
    margin-top: 0;
}

.tool-create, .tool-read, .tool-edit, .tool-multi_edit, .tool-shell, .tool-bash, .tool-invoke_subagent {
    color: #d4d4d8;
}

.tool-header {
    height: auto;
    margin: 0;
    padding: 0;
}

.tool-header-expandable:hover {
    color: #ffffff;
}

.tool-content, .tool-content-md {
    width: 100%;
    height: auto;
    margin: 1 1 0 0;
    padding: 0 1;
    background: #18181b;
    color: #e4e4e7;
    border-left: solid #3f3f46;
    text-wrap: wrap;
}

.tool-call Markdown {
    margin-top: 1;
    color: #e4e4e7;
}

/* Strict Height Auto & Zero Margin for Markdown Elements */
Markdown, MarkdownBlock, MarkdownParagraph {
    link-color: #ffffff;
    link-color-hover: #ffffff;
    link-background-hover: #3f3f46;
    link-style: underline;
    link-style-hover: bold;
}

Markdown {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownParagraph {
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownBlock {
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownBlockQuote MarkdownParagraph {
    margin: 0;
    padding: 0;
}

MarkdownBulletList MarkdownParagraph,
MarkdownOrderedList MarkdownParagraph {
    margin: 0;
    padding: 0;
}

MarkdownBlockQuote MarkdownBlockQuote {
    margin: 0 0 0 2;
    padding: 0 0 0 1;
    border-left: solid #3f3f46;
    background: transparent;
}

MarkdownHeader {
    margin: 1 0 1 0;
}

MarkdownBulletList,
MarkdownOrderedList {
    height: auto;
    margin: 0;
    padding: 0;
}

CustomMarkdownFence,
MarkdownFence {
    background: #18181b;
    margin: 1 0;
    padding: 0;
    border: none;
    height: auto;
    width: 100%;
    max-width: 100%;
    overflow: hidden hidden;
    scrollbar-size: 0 0;
}


CustomMarkdownFence .fence-header,
MarkdownFence .fence-header {
    height: 1;
    width: 100%;
    max-width: 100%;
    background: #27272a;
    padding: 0 0 0 1;
}

CustomMarkdownFence .fence-lang,
MarkdownFence .fence-lang {
    color: #a1a1aa;
    text-style: bold;
    height: 1;
    width: 1fr;
}

CustomMarkdownFence .fence-copy-btn,
MarkdownFence .fence-copy-btn {
    height: 1;
    min-height: 1;
    min-width: 6;
    border: none;
    background: transparent;
    color: #71717a;
    text-style: none;
    padding: 0 1;
    margin: 0;
}

CustomMarkdownFence .fence-copy-btn:hover,
MarkdownFence .fence-copy-btn:hover,
CustomMarkdownFence .fence-copy-btn:focus,
MarkdownFence .fence-copy-btn:focus {
    background: transparent;
    color: #ffffff;
    text-style: none;
}

CustomMarkdownFence .fence-scroll-box,
MarkdownFence .fence-scroll-box {
    width: 100%;
    height: auto;
    scrollbar-size: 0 0 !important;
}

CustomMarkdownFence #code-content,
MarkdownFence #code-content {
    width: 100%;
    height: auto;
    padding: 0 1;
    background: #18181b;
    text-wrap: wrap;
}

/* OptionList Base Styles */
OptionList {
    background: #18181b;
    color: #a1a1aa;
    scrollbar-size: 0 0;
}

OptionList > .option-list--option-highlighted,
OptionList > .option-list--option-blur-highlighted {
    background: #ffffff;
    color: #09090b;
    text-style: bold;
}

OptionList > .option-list--option-hover {
    background: transparent;
}

/* Command Suggestions Popup - Square Solid Dark Border */
#command-suggestions {
    display: none;
    layer: overlay;
    dock: bottom;
    margin-bottom: 5;
    width: 100%;
    height: auto;
    max-height: 5;
    padding: 0;
    border: solid #27272a;
    background: #18181b;
}

#command-suggestions OptionList {
    background: #18181b;
    color: #a1a1aa;
    border: none;
    padding: 0;
    scrollbar-size: 0 0;
}

#command-suggestions OptionList > .option-list--option-highlighted,
#command-suggestions OptionList > .option-list--option-blur-highlighted {
    background: #ffffff;
    color: #09090b;
    text-style: bold;
}

#command-suggestions OptionList > .option-list--option-hover {
    background: transparent;
}

/* Dynamic Auto-Expanding ChatInput - Flat Zinc-900 with bottom padding */
#message-input {
    width: 100%;
    min-height: 2;
    max-height: 6;
    margin: 0;
    padding: 0 1 1 1;
    border: none;
    background: #18181b;
    color: #f4f4f5;
}

#message-input:focus {
    border: none;
    background: #18181b;
}

#message-input > .text-area--cursor-line {
    background: transparent;
}

#message-input > .text-area--selection {
    background: #ffffff;
    color: #09090b;
}

TextArea > .text-area--matching-bracket,
#message-input > .text-area--matching-bracket {
    background: transparent;
    text-style: none;
}


/* Suppress hover tooltips globally */
Tooltip {
    display: none !important;
}

/* Notifications (Toast) Docked Top Right - Monochrome Slate */
ToastRack {
    dock: top;
    align: right top;
}

Toast {
    background: #18181b;
    color: #f4f4f5;
    border-left: solid #61afef;
    border-top: none;
    border-right: none;
    border-bottom: none;
}

Toast.-information {
    background: #18181b;
    color: #f4f4f5;
    border-left: solid #61afef;
}

Toast.-warning {
    background: #18181b;
    color: #f4f4f5;
    border-left: solid #e5c07b;
}

Toast.-error {
    background: #18181b;
    color: #ffffff;
    border-left: solid #e06c75;
}

/* Modal Dialog Styles - Pure Dark Glassmorphism Effect */
ModalScreen {
    align: center middle;
    background: rgba(9, 9, 11, 0.85);
    overflow: hidden;
    scrollbar-size: 0 0 !important;
}

#modal-dialog {
    width: 90%;
    max-width: 78;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: solid #27272a;
    background: #18181b;
    overflow-y: auto;
}

#modal-dialog.modal-dialog-medium,
#modal-dialog.wizard-dialog {
    width: 90%;
    max-width: 86;
}

#modal-dialog.modal-dialog-wide {
    width: 90%;
    max-width: 104;
}

#subagent-container {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: #09090b;
}

#subagent-chat-view {
    height: 1fr;
    padding: 1 2 1 2;
    background: #09090b;
    scrollbar-size: 0 0;
}

#wizard-title {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#wizard-title MarkdownHeader {
    text-align: left;
    color: #ffffff;
    margin: 0 0 1 0;
}

#wizard-title MarkdownParagraph {
    text-align: left;
    color: #e4e4e7;
    margin: 0;
}

#modal-search-input {
    margin: 0 0 1 0;
}

.modal-markdown {
    width: 100%;
    height: auto;
    color: #e4e4e7;
    margin-bottom: 0;
    padding: 0 1;
}

#help-body-md {
    margin-top: 1;
}

#api-key-current {
    margin-bottom: 1;
}

.modal-markdown-centered {
    dock: top;
    margin-bottom: 0;
    padding: 0 1;
}

.modal-markdown-centered MarkdownHeader,
.modal-markdown-centered MarkdownH1,
.modal-markdown-centered MarkdownH2,
.modal-markdown-centered MarkdownH3,
.modal-markdown-centered MarkdownH4,
.modal-markdown-centered MarkdownH5,
.modal-markdown-centered MarkdownH6,
#modal-dialog .modal-markdown-centered MarkdownHeader,
#modal-dialog .modal-markdown-centered MarkdownH1,
#modal-dialog .modal-markdown-centered MarkdownH2,
#modal-dialog .modal-markdown-centered MarkdownH3,
#modal-dialog .modal-markdown-centered MarkdownH4,
#modal-dialog .modal-markdown-centered MarkdownH5,
#modal-dialog .modal-markdown-centered MarkdownH6,
#wizard-title MarkdownHeader,
#wizard-title MarkdownH1,
#wizard-title MarkdownH2,
#wizard-title MarkdownH3 {
    content-align: left top !important;
    text-align: left !important;
    color: #ffffff;
    margin: 0 0 1 0;
}

.modal-markdown-centered MarkdownParagraph,
#modal-dialog .modal-markdown-centered MarkdownParagraph {
    content-align: left top !important;
    text-align: left !important;
    color: #e4e4e7;
    margin: 0;
}

.modal-markdown.confirm-summary MarkdownParagraph {
    margin: 0;
}

#wizard-title.confirm-summary {
    margin-bottom: 0;
}

SubagentViewScreen {
    background: #09090b;
}

#modal-dialog.bash-confirm-dialog {
    width: 90%;
    max-width: 68;
    height: auto;
    max-height: 85%;
    overflow-y: hidden;
}

#modal-dialog.bash-confirm-dialog.modal-dialog-wide {
    width: 90%;
    max-width: 104;
}

#modal-dialog.bash-confirm-dialog #modal-hint {
    dock: none;
    margin-top: 1;
}

#modal-dialog.bash-confirm-dialog .modal-markdown {
    margin-bottom: 0;
}

#modal-dialog.bash-confirm-dialog CustomMarkdownFence,
#modal-dialog.bash-confirm-dialog MarkdownFence {
    background: transparent;
    border: none;
    color: #f4f4f5;
    padding: 0;
    margin: 0;
}

#modal-dialog.bash-confirm-dialog CustomMarkdownFence .fence-header,
#modal-dialog.bash-confirm-dialog MarkdownFence .fence-header {
    display: none;
}

#modal-dialog.bash-confirm-dialog CustomMarkdownFence #code-content,
#modal-dialog.bash-confirm-dialog MarkdownFence #code-content {
    background: transparent;
    color: #f4f4f5;
    padding: 0;
    margin: 0;
}

#modal-dialog.bash-confirm-dialog .tool-scroll-box {
    margin: 1 0;
    max-height: 18;
    overflow-y: auto;
    overflow-x: auto;
    background: transparent;
    border-left: solid #3f3f46;
    padding: 0 1;
    scrollbar-size: 0 0 !important;
}

#modal-dialog.bash-confirm-dialog .modal-diff-view {
    width: 100%;
    height: auto;
    background: transparent;
    color: #f4f4f5;
    padding: 0;
    margin: 0;
    text-wrap: nowrap;
}

#modal-dialog #console-log,
ModalScreen #console-log {
    height: 18;
    margin: 0;
    border-left: solid #3f3f46;
    padding: 0 1;
    background: transparent;
    scrollbar-size: 0 0 !important;
}

#modal-dialog OptionList,
#modal-dialog OptionList:focus,
#modal-dialog OptionList:hover,
#modal-dialog HeaderWrapOptionList,
#modal-dialog HeaderWrapOptionList:focus,
#modal-dialog HeaderWrapOptionList:hover,
ModalScreen OptionList,
ModalScreen OptionList:focus,
ModalScreen OptionList:hover {
    height: auto;
    max-height: 12;
    margin: 0;
    border: none;
    background: transparent !important;
    scrollbar-size: 0 0;
    text-overflow: ellipsis;
}

#modal-dialog OptionList > .option-list--option,
ModalScreen OptionList > .option-list--option {
    background: transparent;
}

#modal-dialog OptionList > .option-list--option-disabled,
ModalScreen OptionList > .option-list--option-disabled {
    color: #71717a;
    text-style: bold;
    opacity: 100%;
}

#modal-dialog OptionList > .option-list--option-highlighted,
#modal-dialog OptionList > .option-list--option-blur-highlighted,
ModalScreen OptionList > .option-list--option-highlighted,
ModalScreen OptionList > .option-list--option-blur-highlighted {
    background: #ffffff;
    color: #09090b;
    text-style: bold;
}

#modal-dialog OptionList > .option-list--option-hover,
ModalScreen OptionList > .option-list--option-hover {
    background: transparent;
}

#modal-dialog Input,
#modal-dialog Input:focus,
#write-in-input,
#write-in-input:focus,
#modal-search-input,
#modal-search-input:focus,
#api-key-input,
#api-key-input:focus {
    width: 100%;
    height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    border: none;
    background: transparent !important;
    color: #f4f4f5;
}

#modal-dialog #write-in-input,
#modal-dialog #write-in-input:focus,
#write-in-input,
#write-in-input:focus {
    margin: 1 0 0 0;
}

#modal-dialog Input > .input--placeholder,
#modal-search-input > .input--placeholder,
#write-in-input > .input--placeholder,
#api-key-input > .input--placeholder {
    color: #71717a;
    background: transparent;
}

#modal-dialog Input > .input--selection,
#modal-search-input > .input--selection,
#write-in-input > .input--selection,
#api-key-input > .input--selection {
    background: #ffffff;
    color: #09090b;
}

#modal-hint {
    width: 100%;
    text-align: left;
    color: #71717a;
    margin-top: 1;
    padding: 0 1;
    text-wrap: nowrap;
}

#attachment-bar {
    width: 100%;
    height: 1;
    display: none;
    padding: 0 1;
    background: #18181b;
    color: #71717a;
    overflow-x: auto;
    overflow-y: hidden;
}

AttachmentChip {
    width: auto;
    height: 1;
    margin-right: 1;
    color: #71717a;
}

/* Status Footer - Matching dark grey background with muted zinc text */
#status-footer,
#subagent-status-footer {
    width: 100%;
    height: 3;
    padding: 0 1 1 1;
    background: #18181b;
    color: #71717a;
}

/* Unified Markdown Headers Styling (Clean bold white, no underlines, left aligned) */
MarkdownH1, MarkdownH2, MarkdownH3, MarkdownH4, MarkdownH5, MarkdownH6,
MarkdownHeader {
    content-align: left top;
    text-align: left;
    text-style: bold;
    color: #ffffff;
    background: transparent;
    border: none;
    margin: 1 0 1 0;
    padding: 0;
}

/* Markdown Table Styling - Clean Monochrome Slate header and borders */
MarkdownTableContent {
    keyline: thin #27272a;
}

MarkdownTableContent > .header {
    color: #ffffff;
    text-style: bold;
    background: transparent;
}

MarkdownTableContent > .markdown-table--header {
    color: #ffffff;
    text-style: bold;
}

MarkdownTableContent > .cell {
    color: #e4e4e7;
}

/* Markdown List Bullets & Numbers - Muted Zinc */
MarkdownBullet {
    color: #a1a1aa;
    text-style: bold;
}

/* Markdown Horizontal Rule (---) - Subtle Divider */
MarkdownHorizontalRule {
    border-bottom: solid #27272a;
    height: 1;
    padding-top: 1;
    margin-bottom: 1;
}

/* Markdown Blockquote - Clean Monochrome Slate (Dark Card without extra vertical lines) */
MarkdownBlockQuote {
    border-left: none;
    background: #18181b;
    color: #e4e4e7;
    margin: 1 0;
    padding: 0 1;
}

MarkdownBlockQuote MarkdownFence {
    border: none;
    margin: 0;
    background: transparent;
}

/* Markdown Inline Code - Clean Monochrome Slate (White text on dark zinc background) */
MarkdownBlock:dark > .code_inline,
MarkdownBlock:light > .code_inline,
MarkdownBlock > .code_inline {
    background: #27272a;
    color: #ffffff;
}
