/* Clean Text Stream TCSS */

Screen {
    background: #0d0e15;
    padding: 0;
    margin: 0;
}

#app-container {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: #0d0e15;
}

#chat-view {
    height: 1fr;
    padding: 1 3;
    background: #0d0e15;
    scrollbar-size: 1 1;
}

/* User Message */
.user-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #89b4fa;
}

/* Bot Message Container */
.bot-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #cdd6f4;
}

.bot-label {
    height: auto;
    margin: 0;
    padding: 0;
}

/* Strict Height Auto & Zero Margin for Markdown Elements */
Markdown {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownParagraph {
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownBlock {
    height: auto;
    margin: 0;
    padding: 0;
}

Markdown BulletList {
    height: auto;
    margin: 0;
    padding: 0;
}

Markdown OrderedList {
    height: auto;
    margin: 0;
    padding: 0;
}

/* Input Bar */
#message-input {
    margin: 0 3 1 3;
    border: none;
    border-top: solid #313244;
    background: #0d0e15;
    color: #cdd6f4;
}

#message-input:focus {
    border-top: solid #89b4fa;
}
