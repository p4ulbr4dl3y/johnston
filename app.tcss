/* Clean Text Stream TCSS */

Screen {
    background: #141414;
    padding: 0;
    margin: 0;
}

#app-container {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: #141414;
}

#chat-view {
    height: 1fr;
    padding: 1 3 0 3;
    background: #141414;
    scrollbar-size: 1 1;
}

/* User Message */
.user-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #3b82f6;
}

/* Bot Message Container */
.bot-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #e0e0e0;
}

/* ThinkingWidget Styling */
.thinking-widget {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    color: #808080;
    background: #1a1a1a;
    border-left: solid #404040;
}

.thinking-active {
    color: #ff9e64;
    border-left: solid #ff9e64;
}

.thinking-header {
    height: auto;
    margin: 0;
    padding: 0;
}

.thinking-widget Markdown {
    margin-top: 1;
    color: #a0a0a0;
}

/* Distinct Tool Call Widget Styling */
.tool-call {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    background: #1a1a1a;
    border-left: solid #3b82f6;
    color: #e0e0e0;
}

.tool-create {
    border-left: solid #a6e3a1;
    background: #17241c;
    color: #a6e3a1;
}

.tool-read {
    border-left: solid #3b82f6;
    background: #182033;
    color: #89b4fa;
}

.tool-edit {
    border-left: solid #ff9e64;
    background: #281f18;
    color: #ff9e64;
}

.tool-bash {
    border-left: solid #cba6f7;
    background: #221c2e;
    color: #cba6f7;
}

/* Strict Height Auto & Zero Margin for Markdown Elements */
Markdown {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownParagraph {
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownBlock {
    height: auto;
    margin: 0;
    padding: 0;
}

Markdown BulletList {
    height: auto;
    margin: 0;
    padding: 0;
}

Markdown OrderedList {
    height: auto;
    margin: 0;
    padding: 0;
}

/* Command Suggestions Popup - Matches Input Container Width Exactly */
#command-suggestions {
    display: none;
    height: auto;
    max-height: 8;
    margin: 0 3 0 3;
    padding: 0 1;
    border-top: solid #2a2a2a;
    border-right: solid #2a2a2a;
    border-left: solid #3b82f6;
    background: #1c1c1c;
}

#command-suggestions OptionList {
    background: #1c1c1c;
    color: #808080;
}

#command-suggestions OptionList > .option-list--option-highlighted {
    background: #ff9e64;
    color: #141414;
    text-style: bold;
}

/* Input Container with Blue Vertical Left Accent */
#input-container {
    width: 100%;
    height: auto;
    margin: 0 3 1 3;
    padding: 0 1;
    border-left: solid #3b82f6;
    background: #1c1c1c;
}

#message-input {
    width: 100%;
    min-height: 1;
    max-height: 10;
    margin: 0;
    padding: 0;
    border: none;
    background: #1c1c1c;
    color: #f0f0f0;
}

#message-input:focus {
    border: none;
    background: #1c1c1c;
}

#input-status-bar {
    height: auto;
    margin-top: 1;
    color: #707070;
}

/* Notifications (Toast) Docked Top Right */
ToastRack {
    dock: top;
    align: right top;
}

/* Modal Dialog Styles (/help & /resume) */
ModalScreen {
    align: center middle;
    background: rgba(20, 20, 20, 0.8);
}

#modal-dialog {
    width: 64;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: solid #ff9e64;
    background: #1c1c1c;
}

.modal-title {
    width: 100%;
    text-align: center;
    color: #ff9e64;
    text-style: bold;
    margin-bottom: 1;
}

.modal-body {
    width: 100%;
    color: #e0e0e0;
    margin-bottom: 1;
}

#resume-option-list {
    height: 8;
    margin-bottom: 1;
    border: solid #2a2a2a;
    background: #141414;
}

#resume-option-list > .option-list--option-highlighted {
    background: #ff9e64;
    color: #141414;
    text-style: bold;
}

.modal-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.modal-buttons Button {
    margin-left: 1;
}
