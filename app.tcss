/* Modern Dark Tech Style - Black, Grey & Neon Mint Accent */

Screen {
    background: #09090b;
    padding: 0;
    margin: 0;
}

#app-container {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: #09090b;
}

#chat-view {
    height: 1fr;
    padding: 1 3 0 3;
    background: #09090b;
    scrollbar-size: 1 1;
}

/* User Message - Neon Mint Highlight */
.user-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #00ffd1;
}

/* Bot Message Container - Off-white Text */
.bot-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #f3f4f6;
}

/* ThinkingWidget Styling - Sleek Dark Grey */
.thinking-widget {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    color: #a1a1aa;
}

.thinking-active {
    color: #00ffd1;
}

.thinking-header {
    height: auto;
    margin: 0;
    padding: 0;
}

.thinking-widget Markdown {
    margin-top: 1;
    color: #a1a1aa;
}

/* Tool Call Widget Styling - Subtle Dark Grey cards with colored left borders */
.tool-call {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    color: #e4e4e7;
}

.tool-create {
    color: #a7f3d0;
}

.tool-read {
    color: #bfdbfe;
}

.tool-edit {
    color: #fde68a;
}

.tool-bash {
    color: #e9d5ff;
}

.tool-header {
    height: auto;
    margin: 0;
    padding: 0;
}

.tool-call Markdown {
    margin-top: 1;
    color: #e4e4e7;
}

.tool-diff-view {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    background: #09090b;
    color: #e4e4e7;
}

/* Strict Height Auto & Zero Margin for Markdown Elements */
Markdown {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownParagraph {
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownBlock {
    height: auto;
    margin: 0;
    padding: 0;
}

Markdown BulletList {
    height: auto;
    margin: 0;
    padding: 0;
}

Markdown OrderedList {
    height: auto;
    margin: 0;
    padding: 0;
}

MarkdownFence {
    background: #18181b;
    margin: 1 0;
    padding: 0 2;
    border-left: solid #27272a;
}

/* Command Suggestions Popup - Square Solid Dark Border */
#command-suggestions {
    display: none;
    width: 100%;
    height: auto;
    max-height: 8;
    margin: 0;
    padding: 0 1;
    border: solid #27272a;
    background: #18181b;
}

#command-suggestions OptionList {
    background: #18181b;
    color: #a1a1aa;
}

#command-suggestions OptionList > .option-list--option-highlighted {
    background: #00ffd1;
    color: #09090b;
    text-style: bold;
}

/* Dynamic Auto-Expanding ChatInput - Flat Zinc-900 with bottom padding */
#message-input {
    width: 100%;
    min-height: 2;
    max-height: 8;
    margin: 0;
    padding: 0 1 1 1;
    border: none;
    background: #18181b;
    color: #f3f4f6;
}

#message-input:focus {
    border: none;
    background: #18181b;
}

#message-input > .text-area--cursor-line {
    background: transparent;
}

/* Notifications (Toast) Docked Top Right */
ToastRack {
    dock: top;
    align: right top;
}

/* Modal Dialog Styles - Pure Dark Glassmorphism Effect */
ModalScreen {
    align: center middle;
    background: rgba(9, 9, 11, 0.8);
}

#modal-dialog {
    width: 64;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: none;
    background: #18181b;
}

.modal-title {
    width: 100%;
    text-align: center;
    color: #00ffd1;
    text-style: bold;
    margin-bottom: 1;
}

.modal-body {
    width: 100%;
    color: #e4e4e7;
    margin-bottom: 1;
}

.modal-markdown {
    width: 100%;
    height: auto;
    color: #e4e4e7;
}

.modal-markdown MarkdownHeader {
    text-align: center;
    color: #00ffd1;
    margin-bottom: 1;
}

#modal-dialog OptionList {
    height: 10;
    max-height: 12;
    margin-top: 1;
    border: solid #27272a;
    background: #09090b;
}

.modal-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.modal-buttons Button {
    margin-left: 1;
}

/* Status Footer - Matching dark grey background with muted zinc text */
#status-footer {
    width: 100%;
    height: 1;
    padding: 0 3;
    background: #18181b;
    color: #71717a;
}
